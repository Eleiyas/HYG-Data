                "textId": "Performance_500401_3511237025_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "非常欢迎大家！\n来参加<style=PlayerName>{homestar}</style>星，\n友邻中心的开业典礼。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_500401_3511237025_content",
                "value": "非常欢迎大家！\n来参加<style=PlayerName>{homestar}</style>星，\n友邻中心的开业典礼。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
