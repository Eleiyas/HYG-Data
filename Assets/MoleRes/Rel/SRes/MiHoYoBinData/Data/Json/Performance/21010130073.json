              },
              "content": "咳咳，忘记说了——\n是上个月的新采访，\n关于今年的十大星屿新发现。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_21010130073_3029094669_content",
                "value": "咳咳，忘记说了——\n是上个月的新采访，\n关于今年的十大星屿新发现。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
