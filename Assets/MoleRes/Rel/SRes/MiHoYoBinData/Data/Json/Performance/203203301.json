            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203203301_2900038051_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "果然！<style=PlayerName>{玩家昵称}</style>，\n{A挑衅坏笑}我的猜想没错，\n“风滚草”飞了这么久终于，自己出现了。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203203301_2900038051_content",
                "value": "果然！<style=PlayerName>{玩家昵称}</style>，\n{A挑衅坏笑}我的猜想没错，\n“风滚草”飞了这么久终于，自己出现了。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
