                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "嗯？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990033_1583461887_content",
                "value": "嗯？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
