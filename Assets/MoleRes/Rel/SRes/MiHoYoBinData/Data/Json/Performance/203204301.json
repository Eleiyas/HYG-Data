                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "之前迁风社的前辈告诉过我,\n无论走到哪里,都要记得随身带一包,\n家乡的种子,现在终于明白是为什么了。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203204301_2915048361_content",
                "value": "之前迁风社的前辈告诉过我,\n无论走到哪里,都要记得随身带一包,\n家乡的种子,现在终于明白是为什么了。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
