                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "里面保存的旋律，也完整了。\n<style=SizeSmall>啵卟~啵啵♪~……</style>",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
