              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_437901_1407216035_fakeName",
                "value": null
              },
              "content": "<style=Highlight>寄售架</style>可以摆在您的星球上，\n随时将闲置物摆上去，\n其他星空好友路过时，就能随时购买。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_437901_1407216035_content",
                "value": "<style=Highlight>寄售架</style>可以摆在您的星球上，\n随时将闲置物摆上去，\n其他星空好友路过时，就能随时购买。"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1407216035
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
