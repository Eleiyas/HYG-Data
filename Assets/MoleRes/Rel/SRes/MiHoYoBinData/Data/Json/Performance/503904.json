          "$type": "System.Collections.Generic.List`1[[miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp]], mscorlib",
          "$values": [
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001122_fakeName",
                "value": null
              },
              "content": "采访？当然可以。\n友邻中心看起来……{A灵光一现}很舒服！\n最重要的是——",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001122_content",
                "value": "采访？当然可以。\n友邻中心看起来……{A灵光一现}很舒服！\n最重要的是——"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3505001122
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001123_fakeName",
                "value": null
              },
              "content": "{A转耳朵}我的耳朵告诉我，它听到了一种，\n让人觉得温暖和安心的声音！就是……\n旅行时到达补给点的时候，会听到的那种。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001123_content",
                "value": "{A转耳朵}我的耳朵告诉我，它听到了一种，\n让人觉得温暖和安心的声音！就是……\n旅行时到达补给点的时候，会听到的那种。"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3505001123
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001124_fakeName",
                "value": null
              },
              "content": "{A点头}话说回来，原来——\n<style=PlayerName>{me}</style>今天是鹊可的小助手？\n我正想跟你分享！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_503904_3505001124_content",
                "value": "{A点头}话说回来，原来——\n<style=PlayerName>{me}</style>今天是鹊可的小助手？\n我正想跟你分享！"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3505001124
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
