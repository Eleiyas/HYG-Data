                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "找到啦！\n{A沉醉闻}藏在桌上像个小糕点……\n不怕莫白把你当做茶点、吃掉吗？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203103801_3140874400_content",
                "value": "找到啦！\n{A沉醉闻}藏在桌上像个小糕点……\n不怕莫白把你当做茶点、吃掉吗？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
