              "content": "又见到你啦，\n<style=PlayerName>{me}</style>。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11000122112_1309714336_content",
                "value": "又见到你啦，\n<style=PlayerName>{me}</style>。",
