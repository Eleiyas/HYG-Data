                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "一开始，我很高兴。\n<style=SizeSmall>这意味着，我没有忘记他们……</style>",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204007401_446704811_content",
