                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "这是我们第一次见面时，\n我听到的旋律。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204007401_446704802_content",
                "value": "这是我们第一次见面时，\n我听到的旋律。",
