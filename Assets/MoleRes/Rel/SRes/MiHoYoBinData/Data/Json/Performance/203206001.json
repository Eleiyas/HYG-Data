          "$values": [
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531299_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "好，一起回家。\n系好安全带，颠簸的时候也可以抓紧我——\n库拉巴塔！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531299_content",
                "value": "好，一起回家。\n系好安全带，颠簸的时候也可以抓紧我——\n库拉巴塔！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2917531299
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "米勒",
              "voiceId": "",
              "fakeName": "米勒",
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531300_fakeName",
                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "嗬？啊、啊啊啊——？！\n你们这就走了？宝藏呢？不是，带我一起吧！\n我保证一路都会很安静不乱说话——",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531300_content",
                "value": "嗬？啊、啊啊啊——？！\n你们这就走了？宝藏呢？不是，带我一起吧！\n我保证一路都会很安静不乱说话——",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2917531300
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531301_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "放心，会有人来接你的。\n友情提示，是你最熟悉的那位治安员。\n接下来你会过上一段作息非常健康的日子。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531301_content",
                "value": "放心，会有人来接你的。\n友情提示，是你最熟悉的那位治安员。\n接下来你会过上一段作息非常健康的日子。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2917531301
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "米勒",
              "voiceId": "",
              "fakeName": "米勒",
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531302_fakeName",
                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "你！你就是这样对待老朋友的吗？\n飞耳多！萨、飞里——嗬啊——",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203206001_2917531302_content",
                "value": "你！你就是这样对待老朋友的吗？\n飞耳多！萨、飞里——嗬啊——",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
