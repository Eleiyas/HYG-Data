                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "其次，可<style=Highlight>格连商店</style>购买的<style=Highlight>花叶拼布沙发椅</style>。\n不管是工作需要还是瘫一会儿，\n沙发椅总是一个绝佳的选择。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203800401_1833829799_content",
                "value": "其次，可<style=Highlight>格连商店</style>购买的<style=Highlight>花叶拼布沙发椅</style>。\n不管是工作需要还是瘫一会儿，\n沙发椅总是一个绝佳的选择。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
