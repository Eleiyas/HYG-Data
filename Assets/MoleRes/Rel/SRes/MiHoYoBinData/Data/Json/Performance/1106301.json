              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1106301_1083305889_fakeName",
                "value": null
              },
              "content": "我们不能干吃菜、吃饭，\n偶尔也可以搭配一些清爽的饮料，\n{A挠头}像茶啊、咳咳，也是其中一种。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1106301_1083305889_content",
                "value": "我们不能干吃菜、吃饭，\n偶尔也可以搭配一些清爽的饮料，\n{A挠头}像茶啊、咳咳，也是其中一种。"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1083305889
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
