                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "诶~？我记得茶具是他朋友？队友？送的，\n莫白一直都很宝贝，怎么会……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_502201_2139707809_content",
                "value": "诶~？我记得茶具是他朋友？队友？送的，\n莫白一直都很宝贝，怎么会……",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
