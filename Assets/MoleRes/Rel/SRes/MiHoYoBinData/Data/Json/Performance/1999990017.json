          "$values": [
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485776_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{玩家转向Actor0}<style=NpcName>热贝尔</style>，第三大道最右侧直行道，\n被改成了直行带右转，\n是你的作品。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485776_content",
                "value": "{玩家转向Actor0}<style=NpcName>热贝尔</style>，第三大道最右侧直行道，\n被改成了直行带右转，\n是你的作品。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485776
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485777_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A挑衅坏笑}没错，我干的，怎么了？\n那条路本来设计就不合理。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485777_content",
                "value": "{A挑衅坏笑}没错，我干的，怎么了？\n那条路本来设计就不合理。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485777
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485778_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "看着那些规规矩矩、守着不合理的路线，\n还忍耐排着长队等待的车流——\n我觉得他们需要一点“惊喜”。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485778_content",
                "value": "看着那些规规矩矩、守着不合理的路线，\n还忍耐排着长队等待的车流——\n我觉得他们需要一点“惊喜”。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485778
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485779_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A思考}你的逻辑回路，到底是基于什么样混乱的算法？\n我甚至想打开你的脑袋，\n检查一下里面装了什么。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485779_content",
                "value": "{A思考}你的逻辑回路，到底是基于什么样混乱的算法？\n我甚至想打开你的脑袋，\n检查一下里面装了什么。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485779
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485780_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A两眼放光}难道，要决斗吗？\n……{短暂停}\n棒！在哪？现在吗？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485780_content",
                "value": "{A两眼放光}难道，要决斗吗？\n……{短暂停}\n棒！在哪？现在吗？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485780
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485781_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A摇头}果然是值得研究的脑回路，\n倒是很像中学时期荷尔蒙爆棚的家伙。\n冷静点，我找你，是为了另一件事。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485781_content",
                "value": "{A摇头}果然是值得研究的脑回路，\n倒是很像中学时期荷尔蒙爆棚的家伙。\n冷静点，我找你，是为了另一件事。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485781
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485782_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A一愣}……啊？\n不决斗？难道你没吃饭？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485782_content",
                "value": "{A一愣}……啊？\n不决斗？难道你没吃饭？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485782
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485783_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A开罚单}根据连续十五个工作日的观测数据，\n在你对标志进行涂改后，\n该路口高峰时段拥堵投诉下降了95%。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485783_content",
                "value": "{A开罚单}根据连续十五个工作日的观测数据，\n在你对标志进行涂改后，\n该路口高峰时段拥堵投诉下降了95%。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485783
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485784_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "你发现了原有路面设计的缺陷——\n直行车道压力过大。\n你的涂鸦，优化了路面资源配置。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485784_content",
                "value": "你发现了原有路面设计的缺陷——\n直行车道压力过大。\n你的涂鸦，优化了路面资源配置。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485784
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485785_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A点头}我并不是来追究你\n破坏公共交通标志的行为，\n虽然那依然会被记录在案。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485785_content",
                "value": "{A点头}我并不是来追究你\n破坏公共交通标志的行为，\n虽然那依然会被记录在案。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485785
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485786_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A拍手}正式通知你，基于你的应急修订方案，\n星海交通已采纳此项修改。\n你的涂鸦版本，将成为官方模板。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485786_content",
                "value": "{A拍手}正式通知你，基于你的应急修订方案，\n星海交通已采纳此项修改。\n你的涂鸦版本，将成为官方模板。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485786
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485787_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A惊讶}等等……\n你是说，官方？模板？？？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485787_content",
                "value": "{A惊讶}等等……\n你是说，官方？模板？？？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485787
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor0",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485788_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A笑眯眯}没错。\n感谢你对星海交通做出——“惊喜”贡献。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990017_1917485788_content",
                "value": "{A笑眯眯}没错。\n感谢你对星海交通做出——“惊喜”贡献。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1917485788
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
