                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A点头}没错，我要继续努力，\n不断精进放风筝技术！\n特别是上天之后，平衡风筝的能力。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990037_1583453633_content",
                "value": "{A点头}没错，我要继续努力，\n不断精进放风筝技术！\n特别是上天之后，平衡风筝的能力。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
