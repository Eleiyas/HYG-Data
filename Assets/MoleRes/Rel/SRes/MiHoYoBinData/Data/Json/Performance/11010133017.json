                "textId": "Performance_11010133017_1698119840_fakeName",
                "value": "",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "<style=PlayerName>{玩家昵称}</style>！\n{A歪头}我的家乡有个习俗——\n亲近的人之间送衣服，是守护平安的意思。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11010133017_1698119840_content",
                "value": "<style=PlayerName>{玩家昵称}</style>！\n{A歪头}我的家乡有个习俗——\n亲近的人之间送衣服，是守护平安的意思。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1698119840
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "PerformTrigger",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11010133017_1698119841_fakeName",
                "value": "",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "我就想……给你也送一件，\n希望你的每一次旅行都能平安回家。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11010133017_1698119841_content",
                "value": "我就想……给你也送一件，\n希望你的每一次旅行都能平安回家。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1698119841
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "PerformTrigger",
