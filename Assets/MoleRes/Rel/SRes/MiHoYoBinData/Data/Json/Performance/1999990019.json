                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "嗯哞？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990019_1917485804_content",
                "value": "嗯哞？",
