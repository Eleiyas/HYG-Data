              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203106702_305969321_fakeName",
                "value": null
              },
              "content": "制作完玩偶，\n我就把那个海贝安置在万象馆。\n墨尔斯准许我，常常来这里观看。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203106702_305969321_content",
                "value": "制作完玩偶，\n我就把那个海贝安置在万象馆。\n墨尔斯准许我，常常来这里观看。"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 305969321
            },
