        "dialogs": {
          "$type": "System.Collections.Generic.List`1[[miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp]], mscorlib",
          "$values": [
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453864_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "看来{A点头}这位神秘人是想要顺着我们理好的线，\n抢先找到最后的毛线团。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453864_content",
                "value": "看来{A点头}这位神秘人是想要顺着我们理好的线，\n抢先找到最后的毛线团。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2891453864
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453865_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "也许他甚至……咳咳，没什么。\n<style=SizeBig>放——心！</style>",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453865_content",
                "value": "也许他甚至……咳咳，没什么。\n<style=SizeBig>放——心！</style>",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2891453865
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453866_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A摊手}不会有人能用那张路线图找到\n“黄金星屿”。\n因为——\n我在上面做了些，只有我会用的、标、记！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453866_content",
                "value": "{A摊手}不会有人能用那张路线图找到\n“黄金星屿”。\n因为——\n我在上面做了些，只有我会用的、标、记！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2891453866
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453867_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "所以接下来，\n{A看我的}我会重新做一份路线规划，\n关键信息都存在脑袋里，只是需要些时间。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203202502_2891453867_content",
                "value": "所以接下来，\n{A看我的}我会重新做一份路线规划，\n关键信息都存在脑袋里，只是需要些时间。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2891453867
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
