                "durationMap": null,
                "chatType": 0
              },
              "content": "我……我也不知道怎咩说。\n我……你来的时候，\n遇到门口的一堆玩偶了咩？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203105101_3152632738_content",
                "value": "我……我也不知道怎咩说。\n我……你来的时候，\n遇到门口的一堆玩偶了咩？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3152632738
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "绵朵莉",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203105101_3152632739_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "我的心里，\n现在也堆满了“玩偶”，\n它们把我的心堵住了。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203105101_3152632739_content",
                "value": "我的心里，\n现在也堆满了“玩偶”，\n它们把我的心堵住了。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
