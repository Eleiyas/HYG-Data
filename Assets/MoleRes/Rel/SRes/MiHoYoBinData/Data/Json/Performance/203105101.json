                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "我……“失忆”了。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203105101_3152632740_content",
                "value": "我……“失忆”了。",
