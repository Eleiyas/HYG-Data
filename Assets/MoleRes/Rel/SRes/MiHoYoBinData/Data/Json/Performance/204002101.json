                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "啵……\n{短暂停}……\n{短暂停}<style=PlayerName>{玩家昵称}</style>，和，{短暂停}墨尔斯……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204002101_1960476847_content",
                "value": "啵……\n{短暂停}……\n{短暂停}<style=PlayerName>{玩家昵称}</style>，和，{短暂停}墨尔斯……",
                "duration": null,
