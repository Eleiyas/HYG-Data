                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "只记得，晕晕乎乎，路过万象馆……\n听到，水的旋律。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204002101_1960476850_content",
                "value": "只记得，晕晕乎乎，路过万象馆……\n听到，水的旋律。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
