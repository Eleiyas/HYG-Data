                "textId": "Performance_1999990014_1917485731_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A叹气}非执勤期间喊我哈佩诺就行，\n我说过的。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
