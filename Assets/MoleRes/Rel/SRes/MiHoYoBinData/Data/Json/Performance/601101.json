                "textId": "Performance_601101_2072145065_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "当然少不了我的，除了祝贺新车站建成，\n更为了祝贺<style=NpcName>艾莎莎尼</style>，\n成为了我们星球的——新车站站长！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_601101_2072145065_content",
