                "textId": "Performance_1999990029_1583461831_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "……{A点头}\n我，试试。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990029_1583461831_content",
                "value": "……{A点头}\n我，试试。",
