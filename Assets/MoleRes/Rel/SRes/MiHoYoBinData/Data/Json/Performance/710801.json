              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_710801_1122616738_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A期待}我、我以后能经常来逛逛嘛？\n在这里我感觉蛮安心的~，\n是那种，大家都想要的丰衣足食的安心。",
