                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "看来，嗝卟，今天，嗝卟，\n没法再唱，嗝卟。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204001401_1944618412_content",
                "value": "看来，嗝卟，今天，嗝卟，\n没法再唱，嗝卟。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1944618412
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
