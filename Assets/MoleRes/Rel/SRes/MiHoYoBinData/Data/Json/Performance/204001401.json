                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "啵~啵卟♪……咳卟。{A摇头}\n<style=PlayerName>{玩家昵称}</style>，稍、稍等。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204001401_1944618410_content",
                "value": "啵~啵卟♪……咳卟。{A摇头}\n<style=PlayerName>{玩家昵称}</style>，稍、稍等。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
