                "textId": "Performance_204001401_1944618411_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "啵~啵~嗝卟。\n{A豆豆眼}……\n{短暂停}这是，打嗝。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204001401_1944618411_content",
                "value": "啵~啵~嗝卟。\n{A豆豆眼}……\n{短暂停}这是，打嗝。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1944618411
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "纳蕾娜",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
