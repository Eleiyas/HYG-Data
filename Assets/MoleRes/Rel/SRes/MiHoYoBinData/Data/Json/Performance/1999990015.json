                "textId": "Performance_1999990015_1917485747_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "<style=SizeBig>明白！</style>\n我会老实交代的——",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990015_1917485747_content",
                "value": "<style=SizeBig>明白！</style>\n我会老实交代的——",
