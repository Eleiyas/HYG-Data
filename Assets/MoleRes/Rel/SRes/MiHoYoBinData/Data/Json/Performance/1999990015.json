                "textId": "Performance_1999990015_1917485756_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A笑眯眯}好了别那么紧张。\nAPP记得常用。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990015_1917485756_content",
                "value": "{A笑眯眯}好了别那么紧张。\nAPP记得常用。",
