          "$values": [
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
