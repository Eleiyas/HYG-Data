                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "一共<style=Highlight>五种</style>颜色的“阿奇宝”，\n不同的人，\n或许会与不同的它们产生共鸣。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_809001_36301_content",
                "value": "一共<style=Highlight>五种</style>颜色的“阿奇宝”，\n不同的人，\n或许会与不同的它们产生共鸣。",
                "duration": null,
                "durationMap": null,
