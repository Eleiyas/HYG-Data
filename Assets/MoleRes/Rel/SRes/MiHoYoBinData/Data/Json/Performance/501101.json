                "textId": "Performance_501101_2127296933_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "非常感谢你帮我完成了一天的协理员工作，\n解决了大家的各种问题咳嚯！\n虽然看起来琐碎，但友邻的生活无小事。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_501101_2127296933_content",
                "value": "非常感谢你帮我完成了一天的协理员工作，\n解决了大家的各种问题咳嚯！\n虽然看起来琐碎，但友邻的生活无小事。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
