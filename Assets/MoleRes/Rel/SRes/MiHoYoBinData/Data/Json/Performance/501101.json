              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_501101_2127296931_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A想象}我记得，上一次生病还是九年前，\n搞砸队友安排的团建度假……\n果然人一旦放松下来，就容易生病。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_501101_2127296931_content",
                "value": "{A想象}我记得，上一次生病还是九年前，\n搞砸队友安排的团建度假……\n果然人一旦放松下来，就容易生病。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
