                "textId": "Performance_501101_2127296932_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A害羞挠头}幸运的是每次生病，\n都有值得信赖的人在。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_501101_2127296932_content",
                "value": "{A害羞挠头}幸运的是每次生病，\n都有值得信赖的人在。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2127296932
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
