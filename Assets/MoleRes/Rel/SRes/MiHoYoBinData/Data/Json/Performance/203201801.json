                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "除了海岸生物，\n还有一个很关键的——{A加油}沿途的补给！\n得确认<style=Highlight>迁风社的无人贩卖车</style>是否正常运作。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203201801_2890831015_content",
                "value": "除了海岸生物，\n还有一个很关键的——{A加油}沿途的补给！\n得确认<style=Highlight>迁风社的无人贩卖车</style>是否正常运作。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
