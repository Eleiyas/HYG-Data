              },
              "content": "{A笑眯眯}好呐好呐，毛绒绒的家，\n需要同样毛绒绒的你——\n一起创作！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_22",
                "value": "{A笑眯眯}好呐好呐，毛绒绒的家，\n需要同样毛绒绒的你——\n一起创作！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
