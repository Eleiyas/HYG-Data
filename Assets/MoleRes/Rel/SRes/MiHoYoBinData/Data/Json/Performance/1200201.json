              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 0
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "绵朵莉",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_23",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "我想一想，\n和玩偶们一起创作的灵感下午茶……\n嗯，需要慢慢地来，放轻松，才能创作呐。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_24",
                "value": "我想一想，\n和玩偶们一起创作的灵感下午茶……\n嗯，需要慢慢地来，放轻松，才能创作呐。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 0
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "绵朵莉",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_25",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "首先，下午茶，当然需要的杯子，\n就用，{A灵光一现}从格连商店购买的<style=Highlight>粉白陶瓷杯</style>。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_26",
                "value": "首先，下午茶，当然需要的杯子，\n就用，{A灵光一现}从格连商店购买的<style=Highlight>粉白陶瓷杯</style>。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
