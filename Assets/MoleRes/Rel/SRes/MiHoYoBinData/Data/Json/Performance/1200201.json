              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1200201_textmap_21",
                "value": null,
                "duration": null,
                "durationMap": null,
