                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "纸条上写着——玩偶“守护人”，\n恭喜你找到第一只！我将加大难度，\n下一次消失的玩偶，没有线索！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203109801_1266371747_content",
                "value": "纸条上写着——玩偶“守护人”，\n恭喜你找到第一只！我将加大难度，\n下一次消失的玩偶，没有线索！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
