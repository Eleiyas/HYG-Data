                "durationMap": null,
                "chatType": 0
              },
              "content": "是上次和绵朵莉捉迷藏时，找到的玩偶。\n玩偶底部有一张纸条？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203109801_1266371746_content",
                "value": "是上次和绵朵莉捉迷藏时，找到的玩偶。\n玩偶底部有一张纸条？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1266371746
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
