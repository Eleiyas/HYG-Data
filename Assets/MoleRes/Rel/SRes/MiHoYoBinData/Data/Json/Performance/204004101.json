                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "那个淘气的大龙虾突然冲过来，\n把你和纳蕾娜撞在一起了！\n结果你就晕了过去……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204004101_2993373616_content",
                "value": "那个淘气的大龙虾突然冲过来，\n把你和纳蕾娜撞在一起了！\n结果你就晕了过去……",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
