                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "艾莎莎尼，适合更成熟，更酷的曲风。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204004101_2993373606_content",
                "value": "艾莎莎尼，适合更成熟，更酷的曲风。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
