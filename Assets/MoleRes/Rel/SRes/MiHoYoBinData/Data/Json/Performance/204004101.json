                "textId": "Performance_204004101_2993373605_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "嚯？原来写的不是艾莎莎尼……\n啊！非常感谢纳蕾娜为我谱的曲子，\n让我知道大家心里，我还有这样的一面。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204004101_2993373605_content",
                "value": "嚯？原来写的不是艾莎莎尼……\n啊！非常感谢纳蕾娜为我谱的曲子，\n让我知道大家心里，我还有这样的一面。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2993373605
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "纳蕾娜",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
