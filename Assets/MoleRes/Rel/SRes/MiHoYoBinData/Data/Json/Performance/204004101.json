                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A豆豆眼}啊？这么甜的旋律是莫白的印象曲？\n我还写了甜甜圈，绵绵糖的歌词？！\n<style=SizeSmall>我的耳朵都要打结了。</style>",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204004101_2993373604_content",
                "value": "{A豆豆眼}啊？这么甜的旋律是莫白的印象曲？\n我还写了甜甜圈，绵绵糖的歌词？！\n<style=SizeSmall>我的耳朵都要打结了。</style>",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2993373604
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "莫白",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
