                "durationMap": null,
                "chatType": 0
              },
              "content": "我按照它们的习性，\n安置在其所需环境的水族缸中。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_904001_1545514401_content",
                "value": "我按照它们的习性，\n安置在其所需环境的水族缸中。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
