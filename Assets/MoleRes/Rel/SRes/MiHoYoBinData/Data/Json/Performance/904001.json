                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "哈哈……看来，它们的状态都很不错。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_904001_1068550816_content",
                "value": "哈哈……看来，它们的状态都很不错。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
