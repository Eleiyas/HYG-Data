                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A惊叹}<style=SizeBig>震撼！</style>……克制。\n萨飞里果然无所不知！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990051_2534703020_content",
                "value": "{A惊叹}<style=SizeBig>震撼！</style>……克制。\n萨飞里果然无所不知！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
