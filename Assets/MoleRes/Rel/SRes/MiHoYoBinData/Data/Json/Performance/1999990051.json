              "content": "{A失落}哼！惭愧——！\n我刚才好像把什么东西撞飞了，\n请问你有看见哞？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990051_2534703017_content",
                "value": "{A失落}哼！惭愧——！\n我刚才好像把什么东西撞飞了，\n请问你有看见哞？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
