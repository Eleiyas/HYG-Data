                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A看我的}万分感谢！\n……嗯哞？我到底撞到了什么？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990051_2534703022_content",
                "value": "{A看我的}万分感谢！\n……嗯哞？我到底撞到了什么？",
