                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A点头}放心。\n我看到热贝尔已经拿着绳子追过去了，\n飞不远。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990051_2534703021_content",
                "value": "{A点头}放心。\n我看到热贝尔已经拿着绳子追过去了，\n飞不远。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2534703021
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
