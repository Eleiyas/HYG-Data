                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A想象}蓝蓝的、红红的，\n轻飘飘的……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990051_2534703018_content",
                "value": "{A想象}蓝蓝的、红红的，\n轻飘飘的……",
