                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "啵？\n曲子，是记录，\n我们现在，已经在一起谱曲。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990047_2534707107_content",
                "value": "啵？\n曲子，是记录，\n我们现在，已经在一起谱曲。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2534707107
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
