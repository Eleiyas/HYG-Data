                "textId": "Performance_1999990047_2534707106_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "纳蕾娜的曲子也好好听，\n{A害羞冒烟}所以我、我想着、想着能不能，\n请你也给我谱首曲子……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990047_2534707106_content",
                "value": "纳蕾娜的曲子也好好听，\n{A害羞冒烟}所以我、我想着、想着能不能，\n请你也给我谱首曲子……",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2534707106
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
