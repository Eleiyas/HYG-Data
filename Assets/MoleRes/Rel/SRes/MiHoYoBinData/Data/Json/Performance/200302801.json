            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "云果",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332656_fakeName",
                "value": null
              },
              "content": "以后你想吃，也能自己种的。\n万一，万一嘛，你不想自己种……\n{A想到了}要不，放在作物园的<style=Highlight>作物箱</style>里？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332656_content",
                "value": "以后你想吃，也能自己种的。\n万一，万一嘛，你不想自己种……\n{A想到了}要不，放在作物园的<style=Highlight>作物箱</style>里？"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3025332656
            },
