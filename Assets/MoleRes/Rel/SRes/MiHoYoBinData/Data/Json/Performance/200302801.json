                "textId": "Performance_200302801_3025332649_fakeName",
                "value": null
              },
              "content": "学会合作~，互相帮助~，\n也是一种独立生活的能力嘛。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332649_content",
