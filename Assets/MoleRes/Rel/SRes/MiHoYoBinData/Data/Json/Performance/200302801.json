            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "云果",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332645_fakeName",
                "value": null
              },
              "content": "过去都是我自己种好，\n再去分享给你嘛，\n这次是你帮我一起想办法，一起种。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332645_content",
                "value": "过去都是我自己种好，\n再去分享给你嘛，\n这次是你帮我一起想办法，一起种。"
