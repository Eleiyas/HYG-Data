              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "云果",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332657_fakeName",
                "value": null
              },
              "content": "我来帮你种在作物园里，你想吃就来摘。\n姥爷跟我讲，\n“为一个人守一座山，一守一辈子，帅得很。”",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332657_content",
                "value": "我来帮你种在作物园里，你想吃就来摘。\n姥爷跟我讲，\n“为一个人守一座山，一守一辈子，帅得很。”"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3025332657
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "云果",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332658_fakeName",
                "value": null
              },
              "content": "我没有姥爷那么厉害，能守好这个作物园，\n帮你种好各种各样的蔬果作物，\n我就觉得很帅气了~！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_200302801_3025332658_content",
                "value": "我没有姥爷那么厉害，能守好这个作物园，\n帮你种好各种各样的蔬果作物，\n我就觉得很帅气了~！"
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 3025332658
            },
