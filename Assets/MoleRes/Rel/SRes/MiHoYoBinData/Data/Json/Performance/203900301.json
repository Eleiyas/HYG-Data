                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A两眼放光}全是我的宝贝！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193954_content",
                "value": "{A两眼放光}全是我的宝贝！",
