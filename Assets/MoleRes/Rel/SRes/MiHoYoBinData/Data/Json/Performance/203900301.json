                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193965_content",
                "value": "{A想象}之前见过<style=Highlight>橘黄复古冰箱</style>，\n一天八顿饭，没有它不行。\n在哪？在<style=Highlight>格连商店</style>里见到的。",
