              "textGuid": 2624193954
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "艾莎莎尼",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193955_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "啊是是，都是宝贝。\n不过就是说，你家真的装得下吗？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193955_content",
                "value": "啊是是，都是宝贝。\n不过就是说，你家真的装得下吗？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2624193955
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "热贝尔",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193956_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "放得下，虽然房间不大，\n{A挑衅坏笑}但这里一堆，那里一堆，\n然后床上也一堆，就能……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193956_content",
                "value": "放得下，虽然房间不大，\n{A挑衅坏笑}但这里一堆，那里一堆，\n然后床上也一堆，就能……",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2624193956
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "艾莎莎尼",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193957_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "那桌放哪？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193957_content",
                "value": "那桌放哪？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2624193957
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "热贝尔",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193958_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "没桌，坐地上能吃饭。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193958_content",
                "value": "没桌，坐地上能吃饭。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2624193958
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "艾莎莎尼",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193959_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "冰箱呢？厨具呢？\n你不会真的只有一张床和一扇窗吧？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193959_content",
                "value": "冰箱呢？厨具呢？\n你不会真的只有一张床和一扇窗吧？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2624193959
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "热贝尔",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193960_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A自信叉腰}还有一个矮凳嗷！\n而且上面也放着矿石大宝贝，\n那是一块彩色的……",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203900301_2624193960_content",
