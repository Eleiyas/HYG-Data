                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "今天虽然没有街头调研，\n但还是很庆幸能再见到你。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11010172112_3720908449_content",
                "value": "今天虽然没有街头调研，\n但还是很庆幸能再见到你。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
