                "chatType": 0
              },
              "content": "嗯？你换了新发色？\n{A思考}像角色更新了立绘，\n比之前更有故事感了。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_21010170083_2334632709_content",
                "value": "嗯？你换了新发色？\n{A思考}像角色更新了立绘，\n比之前更有故事感了。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
