                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "你的头发颜色，\n乍一看像夜晚的星空，\n安静，但有深度。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_21010170083_2334632711_content",
                "value": "你的头发颜色，\n乍一看像夜晚的星空，\n安静，但有深度。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
