              },
              "content": "{A笑哈哈}又见面了，<style=PlayerName>{me}</style>。\n旅途愉快，库拉巴塔！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11010132112_1712370848_content",
                "value": "{A笑哈哈}又见面了，<style=PlayerName>{me}</style>。\n旅途愉快，库拉巴塔！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
