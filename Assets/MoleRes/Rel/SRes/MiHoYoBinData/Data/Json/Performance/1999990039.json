                "textId": "Performance_1999990039_1583453657_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "我，想想……\n兜丸的，旋律，应该是……{短暂停}\n啵~啵啵~♪",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990039_1583453657_content",
                "value": "我，想想……\n兜丸的，旋律，应该是……{短暂停}\n啵~啵啵~♪",
                "duration": null,
                "durationMap": null,
                "chatType": 0
