                "textId": "Performance_204002802_1979456419_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "曲谱里，这一小节，\n记录着今天晒曲谱的事。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_204002802_1979456419_content",
                "value": "曲谱里，这一小节，\n记录着今天晒曲谱的事。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
