            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "纳蕾娜",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
