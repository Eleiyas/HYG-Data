                "chatType": 0
              },
              "content": "{A加油}你的朋友大兜丸，\n成功当爸爸了吗？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1999990044_1947506360_content",
                "value": "{A加油}你的朋友大兜丸，\n成功当爸爸了吗？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 1947506360
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "Actor1",
              "voiceId": "",
