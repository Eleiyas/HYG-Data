                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "太久没跟我一起寻宝，\n你的耳朵是不是都——长蘑菇了？\n<style=SizeBig>诶——那是什么？！</style>",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233251_content",
                "value": "太久没跟我一起寻宝，\n你的耳朵是不是都——长蘑菇了？\n<style=SizeBig>诶——那是什么？！</style>",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2902233251
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
