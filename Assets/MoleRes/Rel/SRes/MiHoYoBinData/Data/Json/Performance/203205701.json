                "textId": "Performance_203205701_2902233250_fakeName",
                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "老朋友~飞耳多队长，\n你还是和以前一样聪明，不过嘛——嗬嗬，\n这次你的反应，慢了点。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233250_content",
                "value": "老朋友~飞耳多队长，\n你还是和以前一样聪明，不过嘛——嗬嗬，\n这次你的反应，慢了点。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2902233250
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "米勒",
              "voiceId": "",
              "fakeName": "米勒",
