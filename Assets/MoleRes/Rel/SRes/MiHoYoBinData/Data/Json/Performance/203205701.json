            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "米勒",
              "voiceId": "",
              "fakeName": "米勒",
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233255_fakeName",
                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "别误会老朋友，我只是想给你个惊喜。\n顺便，向你道谢！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233255_content",
                "value": "别误会老朋友，我只是想给你个惊喜。\n顺便，向你道谢！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2902233255
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "米勒",
              "voiceId": "",
              "fakeName": "米勒",
              "fakeName_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233256_fakeName",
                "value": "米勒",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "谢谢你帮我准备好的藏宝图，\n哦对了，你现在住的这个星球……\n物资很丰富嘛！我很喜欢~！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233256_content",
                "value": "谢谢你帮我准备好的藏宝图，\n哦对了，你现在住的这个星球……\n物资很丰富嘛！我很喜欢~！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2902233256
            },
            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "萨飞里",
              "voiceId": "",
              "fakeName": null,
