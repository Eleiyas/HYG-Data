                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233257_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "以前就和你说过，\n拿着不全的路线图去寻宝，风险只会加倍。\n发生危险的时候再多物资也救不了你。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233257_content",
                "value": "以前就和你说过，\n拿着不全的路线图去寻宝，风险只会加倍。\n发生危险的时候再多物资也救不了你。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
              "expressiveDesc": null,
              "textGuid": 2902233257
            },
            {
