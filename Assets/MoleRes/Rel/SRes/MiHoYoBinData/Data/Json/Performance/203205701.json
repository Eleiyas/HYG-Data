                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "米、勒——",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233254_content",
