                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "说起来——\n你不是应该待在小黑屋里反省吗？\n什么情况？",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_203205701_2902233249_content",
                "value": "说起来——\n你不是应该待在小黑屋里反省吗？\n什么情况？",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
