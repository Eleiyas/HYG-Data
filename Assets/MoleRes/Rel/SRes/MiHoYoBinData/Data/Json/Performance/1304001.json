                "textId": "Performance_1304001_3223616425_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "咕——地去新闻采风！\n咕——地收集到优秀素材！\n咕——地播报本次活动最优秀的新闻！",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_1304001_3223616425_content",
                "value": "咕——地去新闻采风！\n咕——地收集到优秀素材！\n咕——地播报本次活动最优秀的新闻！",
                "duration": null,
                "durationMap": null,
                "chatType": 0
