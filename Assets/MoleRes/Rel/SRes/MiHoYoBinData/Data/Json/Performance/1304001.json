            {
              "$type": "miHoYo.HYG.Performance.DialogCfg, Assembly-CSharp",
              "textId": 0,
              "pTimelineId": "",
              "speakerKey": "鹊可",
              "voiceId": "",
              "fakeName": null,
              "fakeName_l10n": {
