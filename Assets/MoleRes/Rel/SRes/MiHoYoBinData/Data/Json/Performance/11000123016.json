                "textId": "Performance_11000123016_31744_fakeName",
                "value": null,
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "content": "{A想象}我想，那是因为，\n你在我心里，像白云一样，\n让我不自觉……想靠近，追随。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11000123016_31744_content",
                "value": "{A想象}我想，那是因为，\n你在我心里，像白云一样，\n让我不自觉……想靠近，追随。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
