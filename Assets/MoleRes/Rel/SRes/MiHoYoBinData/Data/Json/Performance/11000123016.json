              },
              "content": "{A害羞挠头}<style=PlayerName>{玩家昵称}</style>，最近，在散步的时候，\n看着天边的蓝天白云，\n总是想到你。",
              "content_l10n": {
                "$type": "miHoYo.HYG.Localization.LocalizationString, Assembly-Common",
                "textId": "Performance_11000123016_31743_content",
                "value": "{A害羞挠头}<style=PlayerName>{玩家昵称}</style>，最近，在散步的时候，\n看着天边的蓝天白云，\n总是想到你。",
                "duration": null,
                "durationMap": null,
                "chatType": 0
              },
              "nextRule": 0,
              "guardPeriod": 0.0,
              "desc": null,
              "voiceText": null,
